    def log(self, msg):
        ts = datetime.now().strftime("%H:%M:%S")
        line = f"[{ts}] {msg}\n"
        
        if self.log_text:
            try:
                self.log_text.configure(state="normal")
                self.log_text.insert("end", line)
                self.log_text.see("end")
                self.log_text.configure(state="disabled")
            except:
                pass
        
        self.update_status()
    
    def update_status(self):
        if not self.root:
            return
            
        try:
            if self.status_label:
                if state.injected:
                    self.status_label.configure(text="● INJECTED", fg="#00ff00")
                elif state.dll_loaded:
                    self.status_label.configure(text="● DLL LOADED", fg="#00aaff")
                elif state.is_registered:
                    self.status_label.configure(text="● READY", fg="#ffff00")
                elif state.setup_complete:
                    self.status_label.configure(text="● SETUP OK", fg="#00aaff")
                else:
                    self.status_label.configure(text="● IDLE", fg="#808080")
            
            if self.info_label:
                username = get_username() or "---"
                rbx = "YES" if state.roblox_detected else "NO"
                clients = len(cloudy.get_clients()) if cloudy.is_loaded() else 0
                dll_status = "LOADED" if state.dll_loaded else "NOT LOADED"
                self.info_label.configure(text=f"USER: {username} | ROBLOX: {rbx} | DLL: {dll_status} | CLIENTS: {clients}")
        except:
            pass
    
    def ensure_dll_loaded(self):
        """Load DLL if not already loaded. Returns (success, message)."""
        if cloudy.is_loaded():
            return True, "Already loaded"
        
        success, msg = cloudy.load()
        if success:
            state.dll_loaded = True
            self.log(f"[ OK ] DLL {msg}")
        else:
            self.log(f"[ERR] DLL {msg}")
        return success, msg
    
    def on_init(self):
        self.set_buttons_state(False)
        try:
            # Load DLL first
            success, msg = self.ensure_dll_loaded()
            if not success:
                return
            
            state.is_registered = True
            state.inject_message = "CLOUDY"
            self.log("[ OK ] Registered: CLOUDY")
            
            success, msg = cloudy.initialize()
            if success:
                self.log(f"[ OK ] {msg}")
            else:
                self.log(f"[ERR] {msg}")
            
            self.update_status()
        finally:
            self.set_buttons_state(True)
    
    def on_inject(self):
        self.set_buttons_state(False)
        try:
            # Ensure DLL is loaded
            success, msg = self.ensure_dll_loaded()
            if not success:
                return
            
            if not state.setup_complete:
                self.log("[ERR] Setup incomplete - click REINSTALL")
                return
            
            if not state.is_registered:
                state.is_registered = True
                state.inject_message = "CLOUDY"
            
            success, msg = cloudy.initialize()
            if not success:
                self.log(f"[ERR] {msg}")
                return
            
            import time
            self.log("[SYS] Waiting for DLL...")
            time.sleep(2)
            
            notif = 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
            success, msg = cloudy.execute(notif)
            
            if success:
                state.injected = True
                self.log("[SYS] Injection complete")
            else:
                self.log(f"[ERR] {msg}")
            
            self.update_status()
        finally:
            self.set_buttons_state(True)
    
    def on_exec(self):
        self.set_buttons_state(False)
        try:
            if not state.is_registered:
                self.log("[ERR] Not registered - click INIT first")
                return
            
            # Ensure DLL is loaded
            if not cloudy.is_loaded():
                self.log("[ERR] DLL not loaded - click INIT first")
                return
            
            script = self.code_text.get("1.0", "end").strip()
            if not script:
                self.log("[ERR] No script entered")
                return
            
            if len(script) > 100000:
                self.log("[ERR] Script too large")
                return
            
            success, msg = cloudy.execute(script)
            if success:
                self.log(f"[ OK ] {msg}")
            else:
                self.log(f"[ERR] {msg}")
        finally:
            self.set_buttons_state(True)
    
    def on_clear(self):
        if self.log_text:
            try:
                self.log_text.configure(state="normal")
                self.log_text.delete("1.0", "end")
                self.log_text.configure(state="disabled")
            except:
                pass
    
    def on_reinstall(self):
        self.set_buttons_state(False)
        try:
            # Unload DLL before reinstalling
            if cloudy.dll:
                try:
                    ctypes.windll.kernel32.FreeLibrary(ctypes.c_void_p(cloudy.dll._handle))
                except:
                    pass
                cloudy.dll = None
                state.dll_loaded = False
            
            state.setup_complete = False
            auto_setup(self.log)
            self.update_status()
        finally:
            self.set_buttons_state(True)
    
    def on_exit(self):
        if self.root:
            try:
                self.root.destroy()
            except:
                pass
        sys.exit()
    
    def run(self):
        self.build()
        self.root.mainloop()

# ===== BOOT SEQUENCE =====
def boot_sequence(log_func):
    log_func("[SYS] CLOUDY TERMINAL v2.2 (Python)")
    log_func("[SYS] INITIALIZING...")
    log_func("[SYS] Loading modules...")
    log_func("[SYS] ┌─────────────────┐")
    log_func("[SYS] │ cloudcore.dll   │ LOADED")
    log_func("[SYS] │ luau_bridge.dll │ LOADED")
    log_func("[SYS] │ net_handler.dll │ LOADED")
    log_func("[SYS] └─────────────────┘")
    
    if is_roblox_open():
        log_func("[SYS] ROBLOX: DETECTED")
    else:
        log_func("[SYS] ROBLOX: NOT FOUND")
        log_func("[SYS] Launch Roblox before injecting")
    
    log_func("[SYS] ══════════════════════════")
    log_func("[SYS] READY - Click INIT to load DLL")
    log_func("[SYS] ══════════════════════════")

# ===== MAIN =====
def main():
    gui = CloudyGUI()
    
    def boot_thread():
        try:
            auto_setup(gui.log)
            boot_sequence(gui.log)
        except Exception as e:
            gui.log(f"[ERR] Boot failed: {e}")
    
    threading.Thread(target=boot_thread, daemon=True).start()
    gui.run()

if __name__ == "__main__":
    main()
