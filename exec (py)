# ===== HELPERS =====
def get_script_dir():
    if getattr(sys, 'frozen', False):
        return Path(sys.executable).parent
    return Path(__file__).parent

def get_dll_path():
    return get_script_dir() / "bin" / "Cloudy.dll"

def format_size(size):
    if size < 1024:
        return f"{size} B"
    elif size < 1048576:
        return f"{size / 1024:.1f} KB"
    return f"{size / 1048576:.1f} MB"

def build_path(file_info):
    base = get_script_dir()
    if file_info["dir"]:
        base = base / file_info["dir"]
    return base / file_info["name"]

# ===== DLL INTERFACE =====
class CloudyDLL:
    def __init__(self):
        self.dll = None
        self.uses_stdcall = False
        self.ptr_size = struct.calcsize("P")
    
    def load(self):
        """Load the DLL and set up function signatures."""
        dll_path = get_dll_path()
        if not dll_path.exists():
            return False, "Cloudy.dll not found"
        
        # Try cdecl first
        try:
            self.dll = ctypes.CDLL(str(dll_path))
            self._setup_signatures()
            return True, "Loaded (cdecl)"
        except Exception as e:
            pass
        
        # Try stdcall if cdecl fails
        try:
            self.dll = ctypes.WinDLL(str(dll_path))
            self.uses_stdcall = True
            self._setup_signatures()
            return True, "Loaded (stdcall)"
        except Exception as e:
            self.dll = None
            return False, f"Load failed: {e}"
    
    def _setup_signatures(self):
        """Set up function signatures for the loaded DLL."""
        self.dll.Initialize.restype = ctypes.c_int
        self.dll.Initialize.argtypes = []
        
        self.dll.GetClients.restype = ctypes.c_void_p
        self.dll.GetClients.argtypes = []
        
        self.dll.ExecuteAsync.restype = ctypes.c_int
        self.dll.ExecuteAsync.argtypes = [
            ctypes.c_char_p,
            ctypes.POINTER(ctypes.c_char_p),
            ctypes.c_int
        ]
    
    def initialize(self):
        if not self.dll:
            return False, "DLL not loaded"
        try:
            result = self.dll.Initialize()
            if result != 0:
                return True, f"Warning: returned {result}"
            return True, "Initialized"
        except Exception as e:
            return False, str(e)
    
    def get_clients(self):
        if not self.dll:
            return []
        
        clients = []
        try:
            raw_ptr = self.dll.GetClients()
            if not raw_ptr:
                return clients
            
            struct_size = self.ptr_size * 2 + 4
            if struct_size % self.ptr_size != 0:
                struct_size += self.ptr_size - (struct_size % self.ptr_size)
            
            for i in range(50):
                offset = i * struct_size
                
                try:
                    name_ptr_addr = raw_ptr + offset + self.ptr_size
                    name_ptr = ctypes.c_char_p.from_address(name_ptr_addr).value
                    
                    if not name_ptr:
                        break
                    
                    version_ptr_addr = raw_ptr + offset
                    version_ptr = ctypes.c_char_p.from_address(version_ptr_addr).value
                    
                    id_addr = raw_ptr + offset + self.ptr_size * 2
                    id_bytes = (ctypes.c_ubyte * 4).from_address(id_addr)
                    id_val = struct.unpack("i", bytes(id_bytes))[0]
                    
                    name = name_ptr.decode("utf-8", errors="replace") if name_ptr else ""
                    version = version_ptr.decode("utf-8", errors="replace") if version_ptr else ""
                    
                    if 0 < len(name) < 100:
                        clients.append({
                            "name": name,
                            "version": version,
                            "id": id_val
                        })
                except (OSError, ValueError):
                    break
                    
        except Exception as e:
            print(f"GetClients error: {e}")
        
        return clients
    
    def execute(self, script):
        if not self.dll:
            return False, "DLL not loaded"
        
        clients = self.get_clients()
        if not clients:
            return False, "No clients connected"
        
        script_bytes = script.encode("utf-8")
        num_clients = len(clients)
        
        CharPtrArray = ctypes.c_char_p * num_clients
        names_array = CharPtrArray()
        
        for i, c in enumerate(clients):
            names_array[i] = c["name"].encode("utf-8")
        
        names_ptr = ctypes.cast(names_array, ctypes.POINTER(ctypes.c_char_p))
        
        try:
            result = self.dll.ExecuteAsync(script_bytes, names_ptr, ctypes.c_int(num_clients))
            if result != 0:
                return True, f"Warning: returned {result}"
            return True, "Executed"
        except Exception as e:
            return False, str(e)
    
    def is_loaded(self):
        return self.dll is not None

cloudy = CloudyDLL()

# ===== DOWNLOAD / SETUP =====
def download_file(url, dest_path, log_func, retries=1):
    dest_path = Path(dest_path)
    
    for attempt in range(1, retries + 1):
        if attempt > 1:
            log_func(f"[DL ] Retry {attempt}/{retries}: {dest_path.name}")
        
        try:
            response = requests.get(url, timeout=30, stream=True)
            response.raise_for_status()
            
            dest_path.parent.mkdir(parents=True, exist_ok=True)
            
            with open(dest_path, "wb") as f:
                for chunk in response.iter_content(chunk_size=8192):
                    f.write(chunk)
            
            actual_size = dest_path.stat().st_size
            if actual_size == 0:
                dest_path.unlink(missing_ok=True)
                return False, "Empty file"
            
            return True, actual_size
            
        except requests.exceptions.Timeout:
            log_func(f"[WRN] Timeout: {dest_path.name}")
        except requests.exceptions.HTTPError as e:
            log_func(f"[WRN] HTTP {e.response.status_code}: {dest_path.name}")
            return False, f"HTTP {e.response.status_code}"
        except requests.exceptions.RequestException as e:
            log_func(f"[WRN] Download error: {e}")
        except IOError as e:
            log_func(f"[WRN] Write error: {e}")
            return False, str(e)
    
    return False, "Max retries exceeded"

def auto_setup(log_func):
    script_dir = get_script_dir()
    bin_dir = script_dir / "bin"
    bin_dir.mkdir(exist_ok=True)
    
    all_good = True
    missing_required = []
    
    for f in REQUIRED_FILES:
        path = build_path(f)
        if not path.exists():
            if f["required"]:
                missing_required.append(f["name"])
            all_good = False
        elif path.stat().st_size < f["min_size"]:
            log_func(f"[WRN] {f['name']} size invalid")
            if f["required"]:
                missing_required.append(f["name"])
            all_good = False
    
    if all_good:
        state.setup_complete = True
        log_func("[SYS] All files validated")
        return True
    
    log_func("[SYS] ═══ DOWNLOADING ═══")
    
    downloaded = 0
    failed = 0
    failed_names = []
    
    for f in REQUIRED_FILES:
        path = build_path(f)
        
        if path.exists() and path.stat().st_size >= f["min_size"]:
            continue
        
        log_func(f"[DL ] {f['name']}...")
        
        success, result = download_file(BASE_URL + f["name"], path, log_func)
        
        if success:
            if result >= f["min_size"]:
                log_func(f"[ OK ] {f['name']} ({format_size(result)})")
                downloaded += 1
            else:
                path.unlink(missing_ok=True)
                log_func(f"[ERR] {f['name']} size invalid after download")
                if f["required"]:
                    failed += 1
                    failed_names.append(f["name"])
        else:
            log_func(f"[ERR] {f['name']}: {result}")
            if f["required"]:
                failed += 1
                failed_names.append(f["name"])
    
    log_func("[SYS] ═══ COMPLETE ═══")
    log_func(f"[SYS] Downloaded: {downloaded} | Failed: {failed}")
    
    if failed_names:
        log_func(f"[ERR] Required files missing: {', '.join(failed_names)}")
        state.setup_complete = False
        return False
    
    state.setup_complete = True
    return True

# ===== PROCESS HELPERS =====
def is_roblox_open():
    import subprocess
    try:
        result = subprocess.run(
            ["tasklist", "/FI", "IMAGENAME eq RobloxPlayerBeta.exe", "/NH", "/FO", "CSV"],
            capture_output=True, text=True, timeout=5
        )
        state.roblox_detected = "RobloxPlayerBeta.exe" in result.stdout
        return state.roblox_detected
    except Exception:
        return False

def get_username():
    local_app_data = os.environ.get("LOCALAPPDATA", "")
    if not local_app_data:
        return ""
    
    path = Path(local_app_data) / "Roblox" / "LocalStorage" / "appStorage.json"
    if not path.exists():
        return ""
    
    try:
        import json
        data = json.loads(path.read_text(encoding="utf-8"))
        return data.get("Username", "")
    except Exception:
        return ""

def kill_roblox(log_func):
    import subprocess
    try:
        result = subprocess.run(
            ["taskkill", "/F", "/IM", "RobloxPlayerBeta.exe"],
            capture_output=True, text=True, timeout=10
        )
        if "SUCCESS" in result.stdout:
            log_func("[SYS] Roblox terminated")
            state.injected = False
            state.roblox_detected = False
        else:
            log_func("[SYS] No Roblox processes found")
    except Exception as e:
        log_func(f"[WRN] Kill failed: {e}")

