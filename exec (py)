# ===== DOWNLOAD / SETUP =====
def download_file(url, dest_path, log_func):
    try:
        response = requests.get(url, timeout=30, stream=True)
        response.raise_for_status()
        
        dest_path.parent.mkdir(parents=True, exist_ok=True)
        
        with open(dest_path, "wb") as f:
            for chunk in response.iter_content(chunk_size=8192):
                f.write(chunk)
        
        actual_size = dest_path.stat().st_size
        return True, actual_size
    except requests.exceptions.RequestException as e:
        return False, str(e)
    except Exception as e:
        return False, str(e)

def auto_setup(log_func):
    script_dir = get_script_dir()
    bin_dir = script_dir / "bin"
    bin_dir.mkdir(exist_ok=True)
    
    all_good = True
    missing_required = []
    
    # Check existing files
    for f in REQUIRED_FILES:
        path = build_path(f)
        if not path.exists():
            if f["required"]:
                missing_required.append(f["name"])
            all_good = False
        elif path.stat().st_size < f["min_size"]:
            log_func(f"[WRN] {f['name']} size invalid")
            if f["required"]:
                missing_required.append(f["name"])
            all_good = False
    
    if all_good:
        state.setup_complete = True
        log_func("[SYS] All files validated")
        return True
    
    log_func("[SYS] ═══ DOWNLOADING ═══")
    
    downloaded = 0
    failed = 0
    
    for f in REQUIRED_FILES:
        path = build_path(f)
        
        # Skip if valid
        if path.exists() and path.stat().st_size >= f["min_size"]:
            continue
        
        log_func(f"[DL ] {f['name']}...")
        
        success, result = download_file(BASE_URL + f["name"], path, log_func)
        
        if success:
            if result >= f["min_size"]:
                log_func(f"[ OK ] {f['name']} ({format_size(result)})")
                downloaded += 1
            else:
                path.unlink(missing_ok=True)
                log_func(f"[ERR] {f['name']} size invalid")
                if f["required"]:
                    failed += 1
        else:
            log_func(f"[ERR] {f['name']}: {result}")
            if f["required"]:
                failed += 1
    
    log_func("[SYS] ═══ COMPLETE ═══")
    log_func(f"[SYS] Downloaded: {downloaded} | Failed: {failed}")
    
    if missing_required or failed:
        log_func("[ERR] Required files missing")
        state.setup_complete = False
        return False
    
    state.setup_complete = True
    return True

# ===== PROCESS HELPERS =====
def is_roblox_open():
    import subprocess
    try:
        result = subprocess.run(
            ["tasklist", "/FI", "IMAGENAME eq RobloxPlayerBeta.exe", "/NH"],
            capture_output=True, text=True, timeout=5
        )
        state.roblox_detected = "RobloxPlayerBeta.exe" in result.stdout
        return state.roblox_detected
    except:
        return False

def get_username():
    path = Path(os.environ.get("LOCALAPPDATA", "")) / "Roblox" / "LocalStorage" / "appStorage.json"
    if not path.exists():
        return ""
    try:
        import json
        data = json.loads(path.read_text(encoding="utf-8"))
        return data.get("Username", "")
    except:
        return ""

def kill_roblox(log_func):
    import subprocess
    try:
        result = subprocess.run(
            ["taskkill", "/F", "/IM", "RobloxPlayerBeta.exe"],
            capture_output=True, text=True, timeout=10
        )
        if "SUCCESS" in result.stdout:
            log_func("[SYS] Roblox terminated")
            state.injected = False
            state.roblox_detected = False
        else:
            log_func("[SYS] No Roblox processes found")
    except Exception as e:
        log_func(f"[WRN] Kill failed: {e}")

