# ===== HELPERS =====
def get_script_dir():
    if getattr(sys, 'frozen', False):
        return Path(sys.executable).parent
    return Path(__file__).parent

def get_dll_path():
    return get_script_dir() / "bin" / "Cloudy.dll"

def format_size(bytes_size):
    if bytes_size < 1024:
        return f"{bytes_size} B"
    elif bytes_size < 1048576:
        return f"{bytes_size / 1024:.1f} KB"
    return f"{bytes_size / 1048576:.1f} MB"

def build_path(file_info):
    base = get_script_dir()
    if file_info["dir"]:
        base = base / file_info["dir"]
    return base / file_info["name"]

# ===== DLL INTERFACE =====
class CloudyDLL:
    def __init__(self):
        self.dll = None
        self.ptr_size = struct.calcsize("P")
    
    def load(self):
        dll_path = get_dll_path()
        if not dll_path.exists():
            return False, "Cloudy.dll not found"
        try:
            self.dll = ctypes.CDLL(str(dll_path))
            self.dll.Initialize.restype = ctypes.c_int
            self.dll.Initialize.argtypes = []
            self.dll.ExecuteAsync.restype = ctypes.c_int
            self.dll.ExecuteAsync.argtypes = [
                ctypes.c_char_p,  # script bytes
                ctypes.POINTER(ctypes.c_char_p),  # client names
                ctypes.c_int  # num clients
            ]
            self.dll.GetClients.restype = ctypes.c_void_p
            self.dll.GetClients.argtypes = []
            return True, "Loaded"
        except Exception as e:
            return False, str(e)
    
    def initialize(self):
        if not self.dll:
            return False, "DLL not loaded"
        try:
            result = self.dll.Initialize()
            if result != 0:
                return True, f"Warning: returned {result}"
            return True, "Initialized"
        except Exception as e:
            return False, str(e)
    
    def get_clients(self):
        if not self.dll:
            return []
        
        clients = []
        try:
            ptr = self.dll.GetClients()
            if not ptr:
                return clients
            
            # Struct: char* version, char* name, int id
            struct_size = self.ptr_size * 2 + 4
            if struct_size % self.ptr_size != 0:
                struct_size += self.ptr_size - (struct_size % self.ptr_size)
            
            for i in range(50):
                offset = i * struct_size
                
                # Read name pointer
                name_ptr = ctypes.c_char_p.from_address(ptr + offset + self.ptr_size).value
                if not name_ptr:
                    break
                
                # Read version pointer
                version_ptr = ctypes.c_char_p.from_address(ptr + offset).value
                
                # Read id
                id_val = struct.unpack_from("i", ctypes.string_at(ptr + offset + self.ptr_size * 2, 4))[0]
                
                name = name_ptr.decode("utf-8", errors="replace")
                version = version_ptr.decode("utf-8", errors="replace") if version_ptr else ""
                
                clients.append({
                    "name": name,
                    "version": version,
                    "id": id_val
                })
        except Exception as e:
            print(f"GetClients error: {e}")
        
        return clients
    
    def execute(self, script):
        if not self.dll:
            return False, "DLL not loaded"
        
        clients = self.get_clients()
        if not clients:
            return False, "No clients"
        
        # Build script bytes
        script_bytes = script.encode("utf-8")
        
        # Build client names array
        num_clients = len(clients)
        names_array = (ctypes.c_char_p * num_clients)()
        for i, c in enumerate(clients):
            names_array[i] = c["name"].encode("utf-8")
        
        try:
            result = self.dll.ExecuteAsync(script_bytes, names_array, num_clients)
            if result != 0:
                return True, f"Warning: returned {result}"
            return True, "Executed"
        except Exception as e:
            return False, str(e)

