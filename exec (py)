    def log(self, msg):
        ts = datetime.now().strftime("%H:%M:%S")
        line = f"[{ts}] {msg}\n"
        
        if self.log_text:
            self.log_text.configure(state="normal")
            self.log_text.insert("end", line)
            self.log_text.see("end")
            self.log_text.configure(state="disabled")
        
        self.update_status()
    
    def update_status(self):
        if self.status_label:
            if state.injected:
                self.status_label.configure(text="● INJECTED", fg="#00ff00")
            elif state.is_registered:
                self.status_label.configure(text="● READY", fg="#ffff00")
            elif state.setup_complete:
                self.status_label.configure(text="● SETUP OK", fg="#00aaff")
            else:
                self.status_label.configure(text="● IDLE", fg="#808080")
        
        if self.info_label:
            username = get_username() or "---"
            rbx = "YES" if state.roblox_detected else "NO"
            clients = len(cloudy.get_clients()) if cloudy.dll else 0
            self.info_label.configure(text=f"USER: {username} | ROBLOX: {rbx} | CLIENTS: {clients}")
    
    def on_init(self):
        state.is_registered = True
        state.inject_message = "CLOUDY"
        self.log("[ OK ] Registered: CLOUDY")
        
        success, msg = cloudy.initialize()
        if success:
            self.log(f"[ OK ] {msg}")
        else:
            self.log(f"[ERR] {msg}")
        self.update_status()
    
    def on_inject(self):
        if not state.setup_complete:
            self.log("[ERR] Setup incomplete - click REINSTALL")
            return
        
        if not state.is_registered:
            state.is_registered = True
            state.inject_message = "CLOUDY"
        
        success, msg = cloudy.initialize()
        if not success:
            self.log(f"[ERR] {msg}")
            return
        
        import time
        time.sleep(2)
        
        notif = 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
        success, msg = cloudy.execute(notif)
        
        if success:
            state.injected = True
            self.log("[SYS] Injection complete")
        else:
            self.log(f"[ERR] {msg}")
        
        self.update_status()
    
    def on_exec(self):
        if not state.is_registered:
            self.log("[ERR] Not registered - click INIT first")
            return
        
        script = self.code_text.get("1.0", "end").strip()
        if not script:
            self.log("[ERR] No script entered")
            return
        
        if len(script) > 100000:
            self.log("[ERR] Script too large")
            return
        
        success, msg = cloudy.execute(script)
        if success:
            self.log(f"[ OK ] {msg}")
        else:
            self.log(f"[ERR] {msg}")
    
    def on_clear(self):
        if self.log_text:
            self.log_text.configure(state="normal")
            self.log_text.delete("1.0", "end")
            self.log_text.configure(state="disabled")
    
    def on_reinstall(self):
        state.setup_complete = False
        auto_setup(self.log)
        self.update_status()
    
    def on_exit(self):
        if self.root:
            self.root.destroy()
        sys.exit()
    
    def run(self):
        self.build()
        self.root.mainloop()

# ===== BOOT SEQUENCE =====
def boot_sequence(log_func):
    import time
    log_func("[SYS] CLOUDY TERMINAL v2.0 (Python)")
    time.sleep(0.1)
    log_func("[SYS] INITIALIZING...")
    time.sleep(0.1)
    log_func("[SYS] Loading modules...")
    time.sleep(0.1)
    log_func("[SYS] ┌─────────────────┐")
    log_func("[SYS] │ cloudcore.dll   │ LOADED")
    log_func("[SYS] │ luau_bridge.dll │ LOADED")
    log_func("[SYS] │ net_handler.dll │ LOADED")
    log_func("[SYS] └─────────────────┘")
    time.sleep(0.1)
    
    if is_roblox_open():
        log_func("[SYS] ROBLOX: DETECTED")
    else:
        log_func("[SYS] ROBLOX: NOT FOUND")
        log_func("[SYS] Launch Roblox before injecting")
    
    log_func("[SYS] ══════════════════════════")
    log_func("[SYS] READY")
    log_func("[SYS] ══════════════════════════")

