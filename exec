; ===== LOGGING =====

Log(msg) {
    ts := Format("{:02d}:{:02d}:{:02d}", A_Hour, A_Min, A_Sec)
    consoleLines.Push("[" . ts . "] " . msg)
    if consoleLines.Length > 200
        consoleLines.RemoveAt(1)
    if gui {
        out := ""
        for l in consoleLines
            out .= l . "`n"
        try {
            gui["_Console"].Value := out
            gui["_Console"].EditSelStart := StrLen(out) - 1
        }
    }
    UpdateStatus()
}

UpdateStatus() {
    if !gui
        return
    status := "IDLE"
    color := "c808080"
    if injected {
        status := "INJECTED"
        color := "c00ff00"
    }
    if isRegistered && !injected {
        status := "READY"
        color := "cffff00"
    }
    gui["_Status"].Value := "● " . status
    gui["_Status"].Opt(color)
}

; ===== CRT EFFECT =====

StartCRTEffect() {
    SetTimer(CRTFlash, 100)
}

CRTFlash() {
    global animPhase
    animPhase++
    if !gui
        return
    try {
        ; Subtle scanline effect via border color
        if (Mod(animPhase, 10) = 0) {
            gui.Opt("+Border " . (Mod(animPhase, 20) = 0 ? "0x003300" : "0x002200"))
        }
    }
}

