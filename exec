; ===== HELPERS =====

StringToBuffer(str, encoding := "UTF-8") {
    local size := StrPut(str, encoding)
    local buf := Buffer(size)
    StrPut(str, buf, encoding)
    return buf
}

BuildFilePath(fileDef) {
    return (fileDef.dir ? A_ScriptDir . "\" . fileDef.dir . "\" : A_ScriptDir . "\") . fileDef.name
}

FormatFileSize(bytes) {
    if (bytes < 1024)
        return bytes . " B"
    if (bytes < 1048576)
        return Round(bytes / 1024, 1) . " KB"
    return Round(bytes / 1048576, 1) . " MB"
}

EnsureDirExists(filePath) {
    local dir := ""
    SplitPath(filePath, , &dir)
    if (dir && !DirExist(dir))
        DirCreate(dir)
}

; ===== SHA256 VERIFICATION =====

class HashVerifier {
    static GetFileHash(filePath) {
        if !FileExist(filePath)
            return ""
        try {
            local cmd := 'powershell -NoProfile -Command "(Get-FileHash -Path ''' . StrReplace(filePath, "'", "''") . ''' -Algorithm SHA256).Hash"'
            local hash := Trim(RunCmd(cmd))
            return (hash ? StrLower(hash) : "")
        } catch {
            return ""
        }
    }
    
    static VerifyFile(filePath, expectedHash) {
        if !expectedHash || !FileExist(filePath)
            return false
        local actual := this.GetFileHash(filePath)
        return (actual && StrLower(actual) = StrLower(expectedHash))
    }
    
    static LoadManifest(manifestPath) {
        if !FileExist(manifestPath)
            return Map()
        try {
            local content := FileRead(manifestPath, "UTF-8")
            local manifest := Map()
            content := Trim(content)
            if (SubStr(content, 1, 1) = "{")
                content := SubStr(content, 2, -1)
            if (SubStr(content, -1) = "}")
                content := SubStr(content, 1, -1)
            
            local pairs := StrSplit(content, ",")
            for pair in pairs {
                pair := Trim(pair)
                ; Tolerant regex for JSON key-value
                if RegExMatch(pair, """([^""]+)""\s*:\s*""((?:[^""]|\\.)*)""", &m) {
                    manifest[m[1]] := m[2]
                }
            }
            return manifest
        } catch {
            return Map()
        }
    }
}

RunCmd(cmd) {
    local output := ""
    try {
        local exec := ComObjCreate("WScript.Shell").Exec("cmd /c " . cmd)
        while !exec.Status
            Sleep(10)
        output := exec.StdOut.ReadAll()
    }
    return Trim(output)
}

; ===== AUTO-SETUP =====

AutoSetup() {
    local needsDownload := false
    local missingRequired := []
    local manifest := Map()
    
    Log("[SYS] Checking for manifest...")
    EnsureDirExists(CONFIG.manifestPath)
    local manifestOk := DownloadWithRetry(CONFIG.manifestUrl, CONFIG.manifestPath, false, "")
    
    if manifestOk && FileExist(CONFIG.manifestPath) {
        manifest := HashVerifier.LoadManifest(CONFIG.manifestPath)
        if manifest.Count > 0
            Log("[SYS] Manifest loaded (" . manifest.Count . " entries)")
        else
            Log("[WRN] Manifest parse failed - size-only verification")
    } else {
        Log("[WRN] No manifest - size-only verification")
    }
    
    for f in REQUIRED_FILES {
        local path := BuildFilePath(f)
        local needsUpdate := !FileExist(path)
        
        if FileExist(path) && manifest.Has(f.name) {
            if !HashVerifier.VerifyFile(path, manifest[f.name]) {
                Log("[WRN] " . f.name . " hash mismatch")
                needsUpdate := true
            }
        }
        
        if needsUpdate {
            needsDownload := true
            if f.required
                missingRequired.Push(f.name)
        }
    }
    
    if !needsDownload {
        Log("[SYS] All files verified")
        return true
    }
    
    Log("[SYS] ============ DOWNLOADING ============")
    EnsureDirExists(A_ScriptDir . "\bin")
    
    local success := 0
    local failed := 0
    local failedRequired := []
    
    for f in REQUIRED_FILES {
        local path := BuildFilePath(f)
        local expectedHash := manifest.Has(f.name) ? manifest[f.name] : ""
        
        if FileExist(path) && expectedHash && HashVerifier.VerifyFile(path, expectedHash) {
            Log("[ OK ] " . f.name . " (verified)")
            continue
        }
        
        ; Prevent replacing loaded DLLs
        if (f.name = "Cloudy.dll" && STATE.isRegistered) {
            Log("[SKIP] Cloudy.dll is in use. Restart to update.")
            continue
        }
        
        local downloadOk := DownloadWithRetry(CONFIG.baseUrl . f.name, path, true, expectedHash)
        
        if downloadOk {
            local size := FileGetSize(path)
            local hashStatus := expectedHash ? " [HASH OK]" : ""
            Log("[ OK ] " . f.name . " (" . FormatFileSize(size) . ")" . hashStatus)
            success++
        } else {
            Log("[ERR] " . f.name . " - failed")
            failed++
            if f.required
                failedRequired.Push(f.name)
            if FileExist(path)
                FileDelete(path)
        }
    }
    
    Log("[SYS] ============ COMPLETE ===============")
    Log("[SYS] Downloaded: " . success . " | Failed: " . failed)
    
    if failedRequired.Length > 0 {
        Log("[ERR] Required files missing: " . failedRequired.Join(", "))
        MsgBox("Failed to download required files: " . failedRequired.Join(", ") . "`nCheck your internet connection and click REINSTALL.", "Setup Error", 48)
        return false
    }
    
    if failed > 0
        Log("[WRN] Optional files failed - internal mode may not work")
    
    return true
}

DownloadWithRetry(url, destPath, showProgress := true, expectedHash := "") {
    local tempPath := destPath . ".tmp"
    local lastError := ""
    
    EnsureDirExists(destPath)
    
    for attempt := 1 to CONFIG.maxDownloadRetries {
        if FileExist(tempPath)
            FileDelete(tempPath)
        
        if showProgress && (attempt > 1)
            Log("[DL ] Retry " . attempt . "/" . CONFIG.maxDownloadRetries . "...")
        
        try {
            UrlDownloadToFile(url, tempPath)
            
            if !FileExist(tempPath) {
                lastError := "No file created"
                Sleep(CONFIG.downloadRetryDelay * attempt)
                continue
            }
            
            local size := FileGetSize(tempPath)
            if (size = 0) {
                FileDelete(tempPath)
                lastError := "Empty file"
                Sleep(CONFIG.downloadRetryDelay * attempt)
                continue
            }
            
            if expectedHash && !HashVerifier.VerifyFile(tempPath, expectedHash) {
                FileDelete(tempPath)
                lastError := "Hash mismatch"
                Sleep(CONFIG.downloadRetryDelay * attempt)
                continue
            }
            
            if FileExist(destPath)
                FileDelete(destPath)
            FileMove(tempPath, destPath, 1)
            return true
            
        } catch as e {
            lastError := e.Message
            if FileExist(tempPath)
                FileDelete(tempPath)
            Sleep(CONFIG.downloadRetryDelay * attempt)
        }
    }
    
    Log("[ERR] Failed: " . lastError)
    return false
}

; ===== DLL CALLS =====

Initialize() {
    if !FileExist(CONFIG.dllPath) {
        Log("[ERR] Cloudy.dll missing")
        return false
    }
    try {
        local result := DllCall(CONFIG.dllPath "\Initialize", "CDecl", "Int")
        if (result != 0) {
            Log("[WRN] Initialize returned: " . result)
        }
        Log("[ OK ] Initialized")
        return true
    } catch as e {
        Log("[ERR] Init failed: " . e.Message . " [0x" . Format("{:X}", A_LastError) . "]")
        return false
    }
}

ExecuteScript(script) {
    if !STATE.isRegistered {
        Log("[ERR] Not registered")
        return false
    }
    
    local scriptLen := StrLen(script)
    if (scriptLen > CONFIG.maxScriptSize) {
        Log("[ERR] Script too large (" . scriptLen . " chars)")
        return false
    }
    
    if (scriptLen > CONFIG.confirmLargeScript) {
        local choice := MsgBox("Large script (" . scriptLen . " chars). Execute?", "Confirm", 52)
        if (choice = "No")
            return false
    }
    
    local clients := GetClients()
    if !clients.Length {
        Log("[ERR] No clients connected")
        return false
    }
    
    local scriptBuf := StringToBuffer(script, "UTF-8")
    local numClients := clients.Length
    local ptrArray := Buffer(numClients * A_PtrSize)
    local stringBuffers := []
    
    for i, c in clients {
        local nameBuf := StringToBuffer(c.name, "UTF-8")
        stringBuffers.Push(nameBuf)
        ; FIXED: Correct NumPut parameter order
        NumPut(nameBuf.Ptr, ptrArray, (i - 1) * A_PtrSize, "Ptr")
    }
    
    try {
        ; Explicit return type "Int"
        local result := DllCall(CONFIG.dllPath "\ExecuteAsync", 
            "CDecl", 
            "Ptr", scriptBuf.Ptr,
            "Ptr", ptrArray.Ptr,
            "Int", numClients,
            "Int")
        Log("[ OK ] Script executed")
        return true
    } catch as e {
        Log("[ERR] Execute failed: " . e.Message . " [0x" . Format("{:X}", A_LastError) . "]")
        return false
    }
}

GetClients() {
    local clients := []
    if !FileExist(CONFIG.dllPath)
        return clients
    
    try {
        local ptr := DllCall(CONFIG.dllPath "\GetClients", "CDecl", "Ptr")
        if !ptr
            return clients
        
        local ptrSize := A_PtrSize
        local structSize := (ptrSize * 2) + 4
        if (Mod(structSize, ptrSize) != 0)
            structSize += (ptrSize - Mod(structSize, ptrSize))
        
        loop 50 {
            local offset := (A_Index - 1) * structSize
            
            local namePtr := 0
            try {
                ; FIXED: Safer NumGet usage
                namePtr := NumGet(ptr, offset + ptrSize, "Ptr")
            } catch {
                break
            }
            
            if !namePtr
                break
            
            local versionPtr := 0
            local id := 0
            local version := ""
            local name := ""
            
            try {
                versionPtr := NumGet(ptr, offset, "Ptr")
                id := NumGet(ptr, offset + (ptrSize * 2), "Int")
                name := StrGet(namePtr, "UTF-8")
                if versionPtr
                    version := StrGet(versionPtr, "UTF-8")
            } catch {
                break
            }
            
            clients.Push({name: name, version: version, id: id})
        }
    } catch as e {
        Log("[ERR] GetClients exception: " . e.Message)
    }
    
    return clients
}

Inject() {
    if !STATE.isRegistered
        Register("CLOUDY")
    
    if !Initialize()
        return false
    
    Sleep(2000)
    
    local notif := 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
    local result := ExecuteScript(notif)
    
    if result {
        STATE.injected := true
        Log("[SYS] Injection complete")
    }
    
    return result
}

Register(msg) {
    STATE.injectMessage := msg
    STATE.isRegistered := true
    Log("[ OK ] Registered: " . msg)
}

; ===== PROCESS HELPERS =====

IsRobloxOpen() {
    STATE.robloxPids := []
    try {
        local wmi := ComObjGet("winmgmts:")
        local query := wmi.ExecQuery("Select ProcessId from Win32_Process where Name = 'RobloxPlayerBeta.exe'")
        for p in query
            STATE.robloxPids.Push(p.ProcessId)
    } catch as e {
        Log("[WRN] WMI query failed: " . e.Message)
    }
    return STATE.robloxPids.Length > 0
}

GetUsername() {
    ; FIXED: Use A_LocalAppData instead of hardcoded path
    local path := A_LocalAppData . "\Roblox\LocalStorage\appStorage.json"
    if !FileExist(path)
        return ""
    try {
        local content := FileRead(path, "UTF-8")
        ; FIXED: More tolerant regex for JSON
        if RegExMatch(content, """Username""\s*:\s*""((?:[^""]|\\.)*)""", &m)
            return m[1]
    }
    return ""
}

KillRoblox() {
    local killed := 0
    try {
        for p in ComObjGet("winmgmts:").ExecQuery("Select * from Win32_Process where Name = 'RobloxPlayerBeta.exe'") {
            try {
                p.Terminate()
                killed++
            } catch as e {
                Log("[WRN] Failed to terminate PID " . p.ProcessId)
            }
        }
    }
    if killed {
        Log("[SYS] Terminated " . killed . " process(es)")
        STATE.injected := false
        STATE.robloxPids := []
    } else {
        Log("[SYS] No Roblox processes found")
    }
}

; ===== LOGGING =====

LogToFile(msg) {
    try {
        if FileExist(CONFIG.logFile) {
            local size := FileGetSize(CONFIG.logFile)
            if (size > CONFIG.maxLogSize) {
                local backup := CONFIG.logFile . ".bak"
                if FileExist(backup)
                    FileDelete(backup)
                FileMove(CONFIG.logFile, backup, 1)
            }
        }
        EnsureDirExists(CONFIG.logFile)
        local ts := Format("{:04d}-{:02d}-{:02d} {:02d}:{:02d}:{:02d}", A_Year, A_Mon, A_MDay, A_Hour, A_Min, A_Sec)
        FileAppend(ts . " " . msg . "`n", CONFIG.logFile, "UTF-8")
        STATE.lastLogWriteOk := true
    } catch {
        STATE.lastLogWriteOk := false
    }
}

Log(msg) {
    local ts := Format("{:02d}:{:02d}:{:02d}", A_Hour, A_Min, A_Sec)
    local line := "[" . ts . "] " . msg
    
    LogToFile(msg)
    
    if STATE.gui {
        ; PERFORMANCE FIX: Use EM_REPLACESEL to append instead of rewriting entire control
        static EM_REPLACESEL := 0x00C2
        try {
            SendMessage(EM_REPLACESEL, false, StrPtr(line . "`r`n"), STATE.gui["_Console"].Hwnd)
            UpdateLogStatus()
        }
    }
    
    UpdateStatus()
}

UpdateLogStatus() {
    if !STATE.gui
        return
    local status := STATE.lastLogWriteOk ? "" : " [LOG ERR]"
    STATE.gui["_LogStatus"].Value := status
    STATE.gui["_LogStatus"].Opt(STATE.lastLogWriteOk ? "c004400" : "cff0000")
}

UpdateStatus() {
    if !STATE.gui
        return
    local status := "IDLE"
    local color := "c808080"
    if STATE.injected {
        status := "INJECTED"
        color := "c00ff00"
    } else if STATE.isRegistered {
        status := "READY"
        color := "cffff00"
    }
    STATE.gui["_Status"].Value := "* " . status
    STATE.gui["_Status"].Opt(color)
}

UpdateInfo() {
    if !STATE.gui
        return
    local username := GetUsername()
    local clients := GetClients()
    local pidStr := STATE.robloxPids.Length > 0 ? STATE.robloxPids[1] : "---"
    STATE.gui["_Info"].Value := "USER: " . (username ? username : "---") . " | PID: " . pidStr . " | CLIENTS: " . clients.Length
}

StartClientRefresh() {
    SetTimer(RefreshClients, 5000)
}

StopClientRefresh() {
    SetTimer(RefreshClients, 0)
}

RefreshClients() {
    if !STATE.gui || !STATE.injected
        return
    UpdateInfo()
}

; ===== CRT EFFECT =====

StartCRTEffect() {
    SetTimer(CRTFlash, 150)
}

StopCRTEffect() {
    SetTimer(CRTFlash, 0)
}

CRTFlash() {
    STATE.animPhase++
    if !STATE.gui
        return
    try {
        if (Mod(STATE.animPhase, 8) = 0)
            STATE.gui.Opt("+Border " . (Mod(STATE.animPhase, 16) = 0 ? "0x002200" : "0x001a00"))
    }
}

