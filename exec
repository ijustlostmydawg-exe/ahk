; Safe button handlers
SafeInit() {
    STATE.lastError := ""
    STATE.gui["_Error"].Value := ""
    Register("CLOUDY")
    Initialize()
    UpdateInfo()
}

SafeInject() {
    STATE.lastError := ""
    STATE.gui["_Error"].Value := ""
    if !STATE.setupComplete {
        Log("[ERR] Setup incomplete")
        STATE.gui["_Error"].Value := "Setup incomplete - click REINSTALL"
        return
    }
    Inject()
    UpdateInfo()
}

SafeExecute() {
    STATE.lastError := ""
    STATE.gui["_Error"].Value := ""
    local code := STATE.gui["_Code"].Value
    if (StrLen(Trim(code)) = 0) {
        Log("[ERR] No script entered")
        STATE.gui["_Error"].Value := "No script entered"
        return
    }
    ExecuteScript(code)
}

SafeReinstall() {
    STATE.lastError := ""
    STATE.gui["_Error"].Value := ""
    STATE.setupComplete := false
    AutoSetup()
    UpdateInfo()
}

QuitApp() {
    SetTimer(CRTFlash, 0)
    if STATE.gui
        try STATE.gui.Destroy()
    ExitApp()
}

