            ConsoleLog("⚠ Wait result: " . waitResult)
        }
        
        exitCode := 0
        DllCall("GetExitCodeThread", "Ptr", threadHandle, "UIntP", &exitCode)
        
        injectionLog[A_Now] := {
            code: luaCode,
            address: Format("0x{:X}", allocAddr),
            threadID: threadID,
            exitCode: exitCode,
            timestamp: A_Now
        }
        
        DllCall("CloseHandle", "Ptr", threadHandle)
        
        ConsoleLog("✓✓✓ INJECTION SUCCESSFUL ✓✓✓")
        
        return {
            success: true,
            address: Format("0x{:X}", allocAddr),
            threadID: threadID,
            exitCode: exitCode,
            time: A_Now
        }
    }
    catch Error as err {
        ConsoleLog("✗ Injection error: " . err.What)
        return {success: false, error: err.What}
    }
}

