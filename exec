        ; Execute via remote thread
        threadID := 0
        threadHandle := DllCall("CreateRemoteThread", "Ptr", processHandle, "Ptr", 0, "UInt", 0, "Ptr", luaStateAddr, "Ptr", allocAddr, "UInt", 0, "UIntP", &threadID)
        
        if (!threadHandle) {
            DllCall("VirtualFreeEx", "Ptr", processHandle, "Ptr", allocAddr, "UInt", 0, "UInt", 0x8000)
            return {success: false, error: "Remote thread failed"}
        }
        
