CRTFlash() {
    STATE.animPhase++
    if !STATE.gui
        return
    try {
        if (Mod(STATE.animPhase, 8) = 0) {
            STATE.gui.Opt("+Border " . (Mod(STATE.animPhase, 16) = 0 ? "0x002200" : "0x001a00"))
        }
    }
}

