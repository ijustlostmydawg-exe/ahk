; ===== AUTO-SETUP (with verification) =====

AutoSetup() {
    local needsDownload := false
    local missingRequired := []
    
    ; Check what's missing
    for f in REQUIRED_FILES {
        path := BuildFilePath(f)
        if !FileExist(path) {
            needsDownload := true
            if f.required
                missingRequired.Push(f.name)
        }
    }
    
    if !needsDownload {
        Log("[SYS] All files verified")
        return true
    }
    
    Log("[SYS] ============ DOWNLOADING ============")
    
    ; Create bin folder
    local binPath := A_ScriptDir . "\bin"
    if !DirExist(binPath)
        DirCreate(binPath)
    
    local success := 0
    local failed := 0
    local failedNames := []
    
    for f in REQUIRED_FILES {
        local path := BuildFilePath(f)
        if FileExist(path)
            continue
        
        Log("[DL ] " . f.name . "...")
        
        ; Download to temp file first (atomic)
        local tempPath := path . ".tmp"
        local downloadOk := false
        
        try {
            UrlDownloadToFile(CONFIG.baseUrl . f.name, tempPath)
            
            ; Verify file exists and has size > 0
            if FileExist(tempPath) {
                local size := FileGetSize(tempPath)
                if (size > 0) {
                    FileMove(tempPath, path, 1)  ; Overwrite if exists
                    downloadOk := true
                    Log("[ OK ] " . f.name . " (" . FormatFileSize(size) . ")")
                    success++
                } else {
                    FileDelete(tempPath)
                    Log("[ERR] " . f.name . " - empty file")
                }
            } else {
                Log("[ERR] " . f.name . " - download failed")
            }
        } catch as e {
            if FileExist(tempPath)
                FileDelete(tempPath)
            Log("[ERR] " . f.name . " - " . e.Message)
        }
        
        if !downloadOk {
            failed++
            failedNames.Push(f.name)
        }
    }
    
    Log("[SYS] ============ COMPLETE ===============")
    Log("[SYS] Downloaded: " . success . " | Failed: " . failed)
    
    ; Check if required files are still missing
    for name in missingRequired {
        local found := false
        for f in REQUIRED_FILES {
            if (f.name = name && FileExist(BuildFilePath(f))) {
                found := true
                break
            }
        }
        if !found {
            Log("[ERR] Required file missing: " . name)
            return false
        }
    }
    
    return (failed = 0)
}

BuildFilePath(fileDef) {
    return (fileDef.dir ? A_ScriptDir . "\" . fileDef.dir . "\" : A_ScriptDir . "\") . fileDef.name
}

FormatFileSize(bytes) {
    if (bytes < 1024)
        return bytes . " B"
    if (bytes < 1048576)
        return Round(bytes / 1024, 1) . " KB"
    return Round(bytes / 1048576, 1) . " MB"
}

; ===== SAFE STRING TO BUFFER =====

StringToBuffer(str, encoding := "UTF-8") {
    ; StrPut returns size INCLUDING null terminator
    local size := StrPut(str, encoding)
    local buf := Buffer(size)
    StrPut(str, buf, encoding)
    return buf
}

; ===== DLL CALLS =====

Initialize() {
    if !FileExist(CONFIG.dllPath) {
        Log("[ERR] Cloudy.dll missing - run REINSTALL")
        return false
    }
    try {
        local result := DllCall(CONFIG.dllPath "\Initialize", "CDecl")
        Log("[ OK ] Initialized (return: " . result . ")")
        return true
    } catch as e {
        Log("[ERR] Init failed: " . e.Message)
        return false
    }
}

ExecuteScript(script) {
    if !STATE.isRegistered {
        Log("[ERR] Not registered - click INIT first")
        return false
    }
    
    local clients := GetClients()
    if !clients.Length {
        Log("[ERR] No clients connected")
        return false
    }
    
    ; Safe buffer allocation
    local scriptBuf := StringToBuffer(script, "UTF-8")
    
    local numClients := clients.Length
    local ptrArray := Buffer(numClients * A_PtrSize)
    local stringBuffers := []  ; Keep references alive
    
    for i, c in clients {
        local nameBuf := StringToBuffer(c.name, "UTF-8")
        stringBuffers.Push(nameBuf)
        NumPut("Ptr", nameBuf.Ptr, ptrArray, (i - 1) * A_PtrSize)
    }
    
    try {
        local result := DllCall(CONFIG.dllPath "\ExecuteAsync", 
            "CDecl", 
            "Ptr", scriptBuf.Ptr,
            "Ptr", ptrArray.Ptr,
            "Int", numClients)
        Log("[ OK ] Script executed (return: " . result . ")")
        return true
    } catch as e {
        Log("[ERR] Execute failed: " . e.Message)
        return false
    }
}

; ===== CLIENT LIST PARSING =====
; Expected native struct layout (x64):
; Offset 0x00: char* version  (8 bytes)
; Offset 0x08: char* name     (8 bytes)  
; Offset 0x10: int   id       (4 bytes)
; Offset 0x14: padding        (4 bytes)
; Total: 24 bytes
; NOTE: This may vary - verify against actual DLL

GetClients() {
    local clients := []
    
    if !FileExist(CONFIG.dllPath)
        return clients
    
    try {
        local ptr := DllCall(CONFIG.dllPath "\GetClients", "CDecl", "Ptr")
        if !ptr
            return clients
        
        ; Use A_PtrSize to handle x86/x64 differences
        local structSize := (A_PtrSize * 2) + 4 + ((A_PtrSize = 4) ? 0 : 4)  ; Align to 8 on x64
        local maxClients := 50
        
        loop maxClients {
            local offset := (A_Index - 1) * structSize
            
            local namePtr := NumGet(ptr + offset + A_PtrSize, "Ptr")
            if !namePtr
                break  ; Null name = end of list
            
            local versionPtr := NumGet(ptr + offset, "Ptr")
            local id := NumGet(ptr + offset + (A_PtrSize * 2), "Int")
            
            local version := (versionPtr ? StrGet(versionPtr, "UTF-8") : "")
            local name := StrGet(namePtr, "UTF-8")
            
            clients.Push({name: name, version: version, id: id})
        }
    } catch as e {
        Log("[WRN] GetClients error: " . e.Message)
    }
    
    return clients
}

Inject() {
    if !STATE.isRegistered
        Register("CLOUDY")
    
    if !Initialize()
        return false
    
    Sleep(2000)
    
    local notif := 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
    local result := ExecuteScript(notif)
    
    if result {
        STATE.injected := true
        Log("[SYS] Injection complete")
    }
    
    return result
}

Register(msg) {
    STATE.injectMessage := msg
    STATE.isRegistered := true
    Log("[ OK ] Registered: " . msg)
}

; ===== PROCESS HELPERS =====

IsRobloxOpen() {
    try {
        local wmi := ComObjGet("winmgmts:")
        local query := wmi.ExecQuery("Select ProcessId from Win32_Process where Name = 'RobloxPlayerBeta.exe'")
        for p in query {
            STATE.robloxPid := p.ProcessId
            return true
        }
    }
    STATE.robloxPid := 0
    return false
}

GetUsername() {
    local path := "C:\Users\" . A_UserName . "\AppData\Local\Roblox\LocalStorage\appStorage.json"
    if !FileExist(path)
        return ""
    try {
        local content := FileRead(path, "UTF-8")
        if RegExMatch(content, """Username""\s*:\s*""([^""]+)""", &m)
            return m[1]
    }
    return ""
}

KillRoblox() {
    local killed := 0
    try {
        for p in ComObjGet("winmgmts:").ExecQuery("Select * from Win32_Process where Name = 'RobloxPlayerBeta.exe'") {
            try {
                p.Terminate()
                killed++
            }
        }
    }
    if killed {
        Log("[SYS] Terminated " . killed . " process(es)")
        STATE.injected := false
        STATE.robloxPid := 0
    } else {
        Log("[SYS] No Roblox processes found")
    }
}

; ===== FILE LOGGING =====

LogToFile(msg) {
    try {
        ; Rotate log if too large
        if FileExist(CONFIG.logFile) {
            local size := FileGetSize(CONFIG.logFile)
            if (size > CONFIG.maxLogSize) {
                local backup := CONFIG.logFile . ".bak"
                if FileExist(backup)
                    FileDelete(backup)
                FileMove(CONFIG.logFile, backup, 1)
            }
        }
        
        local ts := Format("{:04d}-{:02d}-{:02d} {:02d}:{:02d}:{:02d}", A_Year, A_Mon, A_MDay, A_Hour, A_Min, A_Sec)
        FileAppend(ts . " " . msg . "`n", CONFIG.logFile, "UTF-8")
    }
}

; ===== CONSOLE LOGGING =====

Log(msg) {
    local ts := Format("{:02d}:{:02d}:{:02d}", A_Hour, A_Min, A_Sec)
    local line := "[" . ts . "] " . msg
    
    STATE.consoleLines.Push(line)
    if STATE.consoleLines.Length > CONFIG.maxLogLines
        STATE.consoleLines.RemoveAt(1)
    
    ; Log to file too
    LogToFile(msg)
    
    ; Update GUI
    if STATE.gui {
        local out := ""
        for l in STATE.consoleLines
            out .= l . "`n"
        try {
            STATE.gui["_Console"].Value := out
            STATE.gui["_Console"].EditSelStart := StrLen(out) - 1
        }
    }
    
    UpdateStatus()
}

UpdateStatus() {
    if !STATE.gui
        return
    
    local status := "IDLE"
    local color := "c808080"
    
    ; Priority: injected > registered > idle
    if STATE.injected {
        status := "INJECTED"
        color := "c00ff00"
    } else if STATE.isRegistered {
        status := "READY"
        color := "cffff00"
    }
    
    STATE.gui["_Status"].Value := "* " . status
    STATE.gui["_Status"].Opt(color)
}

UpdateInfo() {
    if !STATE.gui
        return
    
    local username := GetUsername()
    local clients := GetClients()
    local pid := STATE.robloxPid ? STATE.robloxPid : "---"
    
    STATE.gui["_Info"].Value := "USER: " . (username ? username : "---") . " | PID: " . pid . " | CLIENTS: " . clients.Length
}

; ===== CRT EFFECT =====

StartCRTEffect() {
    SetTimer(CRTFlash, 150)
}

StopCRTEffect() {
    SetTimer(CRTFlash, 0)
}

CRTFlash() {
    STATE.animPhase++
    if !STATE.gui
        return
    try {
        if (Mod(STATE.animPhase, 8) = 0) {
            STATE.gui.Opt("+Border " . (Mod(STATE.animPhase, 16) = 0 ? "0x002200" : "0x001a00"))
        }
    }
}

