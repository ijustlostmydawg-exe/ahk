; ===== SHA256 VERIFICATION =====

class HashVerifier {
    static GetFileHash(filePath) {
        if !FileExist(filePath)
            return ""
        
        try {
            ; Use PowerShell for SHA256 (built into Windows)
            local cmd := 'powershell -NoProfile -Command "(Get-FileHash -Path ''' . StrReplace(filePath, "'", "''") . ''' -Algorithm SHA256).Hash"'
            local hash := Trim(RunCmd(cmd))
            return (hash ? StrLower(hash) : "")
        } catch {
            return ""
        }
    }
    
    static VerifyFile(filePath, expectedHash) {
        if !expectedHash || !FileExist(filePath)
            return false
        
        local actual := this.GetFileHash(filePath)
        if !actual
            return false
        
        return (StrLower(actual) = StrLower(expectedHash))
    }
    
    static LoadManifest(manifestPath) {
        if !FileExist(manifestPath)
            return Map()
        
        try {
            local content := FileRead(manifestPath, "UTF-8")
            ; Simple JSON parse for {"filename": "hash"} format
            local manifest := Map()
            
            ; Remove braces and whitespace
            content := Trim(content)
            if (SubStr(content, 1, 1) = "{")
                content := SubStr(content, 2, -1)
            if (SubStr(content, -1) = "}")
                content := SubStr(content, 1, -1)
            
            ; Parse key-value pairs
            local pairs := StrSplit(content, ",")
            for pair in pairs {
                pair := Trim(pair)
                if RegExMatch(pair, """([^""]+)""\s*:\s*""([^""]+)""", &m) {
                    manifest[m[1]] := m[2]
                }
            }
            
            return manifest
        } catch {
            return Map()
        }
    }
}

; Run command and capture output
RunCmd(cmd) {
    local output := ""
    try {
        local exec := ComObjCreate("WScript.Shell").Exec("cmd /c " . cmd)
        while !exec.Status {
            Sleep(10)
            output .= exec.StdOut.ReadAll()
        }
        output .= exec.StdOut.ReadAll()
    }
    return Trim(output)
}

; ===== SAFE STRING TO BUFFER =====

StringToBuffer(str, encoding := "UTF-8") {
    local size := StrPut(str, encoding)
    local buf := Buffer(size)
    StrPut(str, buf, encoding)
    return buf
}

; ===== AUTO-SETUP (with verification + retries) =====

AutoSetup() {
    local needsDownload := false
    local missingRequired := []
    local manifest := Map()
    
    ; Try to download manifest first
    Log("[SYS] Checking for manifest...")
    local manifestOk := this.DownloadWithRetry(CONFIG.manifestUrl, CONFIG.manifestPath, false)
    
    if manifestOk && FileExist(CONFIG.manifestPath) {
        manifest := HashVerifier.LoadManifest(CONFIG.manifestPath)
        if manifest.Count > 0
            Log("[SYS] Manifest loaded (" . manifest.Count . " entries)")
        else
            Log("[WRN] Manifest parse failed - skipping hash verify")
    } else {
        Log("[WRN] No manifest - size-only verification")
    }
    
    ; Check what's missing
    for f in REQUIRED_FILES {
        local path := BuildFilePath(f)
        local needsUpdate := false
        
        if !FileExist(path) {
            needsDownload := true
            needsUpdate := true
        } else if (manifest.Has(f.name)) {
            ; Verify existing file hash
            if !HashVerifier.VerifyFile(path, manifest[f.name]) {
                Log("[WRN] " . f.name . " hash mismatch - redownloading")
                needsDownload := true
                needsUpdate := true
            }
        }
        
        if needsUpdate && f.required
            missingRequired.Push(f.name)
    }
    
    if !needsDownload {
        Log("[SYS] All files verified")
        return true
    }
    
    Log("[SYS] ============ DOWNLOADING ============")
    
    ; Create bin folder
    local binPath := A_ScriptDir . "\bin"
    if !DirExist(binPath)
        DirCreate(binPath)
    
    local success := 0
    local failed := 0
    local failedNames := []
    local failedRequired := []
    
    for f in REQUIRED_FILES {
        local path := BuildFilePath(f)
        local expectedHash := manifest.Has(f.name) ? manifest[f.name] : ""
        
        ; Check if file already exists and passes hash
        if FileExist(path) && expectedHash && HashVerifier.VerifyFile(path, expectedHash) {
            Log("[ OK ] " . f.name . " (verified)")
            continue
        }
        
        ; Download with retry
        local downloadOk := DownloadWithRetry(CONFIG.baseUrl . f.name, path, true, expectedHash)
        
        if downloadOk {
            local size := FileGetSize(path)
            local hashStatus := expectedHash ? " [HASH OK]" : ""
            Log("[ OK ] " . f.name . " (" . FormatFileSize(size) . ")" . hashStatus)
            success++
        } else {
            Log("[ERR] " . f.name . " - failed after " . CONFIG.maxDownloadRetries . " retries")
            failed++
            failedNames.Push(f.name)
            if f.required
                failedRequired.Push(f.name)
            
            ; Clean up partial file
            if FileExist(path)
                FileDelete(path)
        }
    }
    
    Log("[SYS] ============ COMPLETE ===============")
    Log("[SYS] Downloaded: " . success . " | Failed: " . failed)
    
    ; Check required files
    if failedRequired.Length > 0 {
        Log("[ERR] Required files missing: " . failedRequired.Join(", "))
        return false
    }
    
    ; Warn about optional failures
    if failed > 0 {
        Log("[WRN] Optional files failed: " . failedNames.Join(", "))
        Log("[WRN] Internal mode may not work")
    }
    
    return (failedRequired.Length = 0)
}

; Download with retry and optional hash verification
DownloadWithRetry(url, destPath, showProgress := true, expectedHash := "") {
    local tempPath := destPath . ".tmp"
    local lastError := ""
    
    for attempt := 1 to CONFIG.maxDownloadRetries {
        ; Clean up any previous temp file
        if FileExist(tempPath)
            FileDelete(tempPath)
        
        if showProgress && (attempt > 1)
            Log("[DL ] Retry " . attempt . "/" . CONFIG.maxDownloadRetries . "...")
        
        try {
            UrlDownloadToFile(url, tempPath)
            
            ; Verify file exists and has size > 0
            if !FileExist(tempPath) {
                lastError := "Download returned but no file"
                Sleep(CONFIG.downloadRetryDelay)
                continue
            }
            
            local size := FileGetSize(tempPath)
            if (size = 0) {
                FileDelete(tempPath)
                lastError := "Empty file"
                Sleep(CONFIG.downloadRetryDelay)
                continue
            }
            
            ; Hash verification if provided
            if expectedHash {
                if !HashVerifier.VerifyFile(tempPath, expectedHash) {
                    FileDelete(tempPath)
                    lastError := "Hash mismatch"
                    Log("[WRN] Hash verification failed")
                    Sleep(CONFIG.downloadRetryDelay)
                    continue
                }
            }
            
            ; Success - move temp to final location
            if FileExist(destPath)
                FileDelete(destPath)
            FileMove(tempPath, destPath, 1)
            return true
            
        } catch as e {
            lastError := e.Message
            if FileExist(tempPath)
                FileDelete(tempPath)
            Sleep(CONFIG.downloadRetryDelay)
        }
    }
    
    Log("[ERR] Failed: " . lastError)
    return false
}

BuildFilePath(fileDef) {
    return (fileDef.dir ? A_ScriptDir . "\" . fileDef.dir . "\" : A_ScriptDir . "\") . fileDef.name
}

FormatFileSize(bytes) {
    if (bytes < 1024)
        return bytes . " B"
    if (bytes < 1048576)
        return Round(bytes / 1024, 1) . " KB"
    return Round(bytes / 1048576, 1) . " MB"
}

; ===== DLL CALLS (explicit return types) =====

; void Initialize(void) - no return value
Initialize() {
    if !FileExist(CONFIG.dllPath) {
        Log("[ERR] Cloudy.dll missing - run REINSTALL")
        return false
    }
    try {
        ; Explicit "Ptr" return type (actually void, but AHK needs a type)
        DllCall(CONFIG.dllPath "\Initialize", "CDecl", "Ptr")
        Log("[ OK ] Initialized")
        return true
    } catch as e {
        Log("[ERR] Init failed: " . e.Message . " (LastError: " . A_LastError . ")")
        return false
    }
}

; void ExecuteAsync(byte* script, char** clients, int numClients)
ExecuteScript(script) {
    if !STATE.isRegistered {
        Log("[ERR] Not registered - click INIT first")
        return false
    }
    
    local clients := GetClients()
    if !clients.Length {
        Log("[ERR] No clients connected")
        return false
    }
    
    ; Safe buffer allocation
    local scriptBuf := StringToBuffer(script, "UTF-8")
    
    local numClients := clients.Length
    local ptrArray := Buffer(numClients * A_PtrSize)
    local stringBuffers := []  ; Keep references alive
    
    for i, c in clients {
        local nameBuf := StringToBuffer(c.name, "UTF-8")
        stringBuffers.Push(nameBuf)
        NumPut("Ptr", nameBuf.Ptr, ptrArray, (i - 1) * A_PtrSize)
    }
    
    try {
        ; Explicit return type "Ptr" (actually void)
        DllCall(CONFIG.dllPath "\ExecuteAsync", 
            "CDecl", 
            "Ptr", scriptBuf.Ptr,       ; byte* scriptSource
            "Ptr", ptrArray.Ptr,         ; char** clientUsers
            "Int", numClients,           ; int numUsers
            "Ptr")                       ; return type
        Log("[ OK ] Script executed")
        return true
    } catch as e {
        Log("[ERR] Execute failed: " . e.Message . " (LastError: " . A_LastError . ")")
        return false
    }
}

; ClientInfo* GetClients(void) - returns pointer to struct array
; Struct layout (x64):
;   Offset 0x00: char* version  (8 bytes)
;   Offset 0x08: char* name     (8 bytes)
;   Offset 0x10: int   id       (4 bytes)
;   Offset 0x14: int   padding  (4 bytes)
;   Total: 24 bytes
; NOTE: x86 would be 12 bytes (4+4+4), no padding needed

GetClients() {
    local clients := []
    
    if !FileExist(CONFIG.dllPath)
        return clients
    
    try {
        ; Explicit "Ptr" return type for struct pointer
        local ptr := DllCall(CONFIG.dllPath "\GetClients", "CDecl", "Ptr")
        
        if !ptr {
            Log("[WRN] GetClients returned null")
            return clients
        }
        
        ; Calculate struct size based on pointer size
        local ptrSize := A_PtrSize
        local intSize := 4
        local structSize := (ptrSize * 2) + intSize
        ; Align to pointer size boundary
        if (Mod(structSize, ptrSize) != 0)
            structSize += (ptrSize - Mod(structSize, ptrSize))
        
        local maxClients := 50
        local parsedOk := true
        
        loop maxClients {
            local offset := (A_Index - 1) * structSize
            
            ; Safety: check if we can read this far
            ; Read name pointer first - if null, end of list
            local namePtr := 0
            try {
                namePtr := NumGet(ptr + offset + ptrSize, "Ptr")
            } catch {
                Log("[WRN] GetClients: read error at offset " . offset)
                parsedOk := false
                break
            }
            
            if !namePtr
                break  ; Null name = end of list
            
            ; Read other fields
            local versionPtr := 0
            local id := 0
            
            try {
                versionPtr := NumGet(ptr + offset, "Ptr")
                id := NumGet(ptr + offset + (ptrSize * 2), "Int")
            } catch as e {
                Log("[WRN] GetClients: struct read error - " . e.Message)
                parsedOk := false
                break
            }
            
            ; Validate pointers before reading strings
            local version := ""
            local name := ""
            
            try {
                name := StrGet(namePtr, "UTF-8")
                if versionPtr
                    version := StrGet(versionPtr, "UTF-8")
            } catch as e {
                Log("[WRN] GetClients: string read error - " . e.Message)
                break
            }
            
            clients.Push({name: name, version: version, id: id})
        }
        
        if !parsedOk
            Log("[WRN] GetClients: partial parse, may have corrupt data")
            
    } catch as e {
        Log("[ERR] GetClients exception: " . e.Message)
    }
    
    return clients
}

Inject() {
    if !STATE.isRegistered
        Register("CLOUDY")
    
    if !Initialize()
        return false
    
    Sleep(2000)
    
    local notif := 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
    local result := ExecuteScript(notif)
    
    if result {
        STATE.injected := true
        Log("[SYS] Injection complete")
    }
    
    return result
}

Register(msg) {
    STATE.injectMessage := msg
    STATE.isRegistered := true
    Log("[ OK ] Registered: " . msg)
}

; ===== PROCESS HELPERS =====

IsRobloxOpen() {
    STATE.robloxPids := []
    
    try {
        local wmi := ComObjGet("winmgmts:")
        local query := wmi.ExecQuery("Select ProcessId from Win32_Process where Name = 'RobloxPlayerBeta.exe'")
        
        for p in query {
            STATE.robloxPids.Push(p.ProcessId)
        }
    } catch as e {
        Log("[WRN] WMI query failed: " . e.Message)
    }
    
    return STATE.robloxPids.Length > 0
}

GetUsername() {
    local path := "C:\Users\" . A_UserName . "\AppData\Local\Roblox\LocalStorage\appStorage.json"
    if !FileExist(path)
        return ""
    try {
        local content := FileRead(path, "UTF-8")
        if RegExMatch(content, """Username""\s*:\s*""([^""]+)""", &m)
            return m[1]
    }
    return ""
}

KillRoblox() {
    local killed := 0
    try {
        for p in ComObjGet("winmgmts:").ExecQuery("Select * from Win32_Process where Name = 'RobloxPlayerBeta.exe'") {
            try {
                p.Terminate()
                killed++
            } catch as e {
                Log("[WRN] Failed to terminate PID " . p.ProcessId . ": " . e.Message)
            }
        }
    }
    if killed {
        Log("[SYS] Terminated " . killed . " process(es)")
        STATE.injected := false
        STATE.robloxPids := []
    } else {
        Log("[SYS] No Roblox processes found")
    }
}

; ===== FILE LOGGING (with error reporting) =====

LogToFile(msg) {
    try {
        ; Rotate log if too large
        if FileExist(CONFIG.logFile) {
            local size := FileGetSize(CONFIG.logFile)
            if (size > CONFIG.maxLogSize) {
                local backup := CONFIG.logFile . ".bak"
                if FileExist(backup)
                    FileDelete(backup)
                FileMove(CONFIG.logFile, backup, 1)
            }
        }
        
        local ts := Format("{:04d}-{:02d}-{:02d} {:02d}:{:02d}:{:02d}", A_Year, A_Mon, A_MDay, A_Hour, A_Min, A_Sec)
        FileAppend(ts . " " . msg . "`n", CONFIG.logFile, "UTF-8")
        STATE.lastLogWriteOk := true
    } catch as e {
        STATE.lastLogWriteOk := false
        ; Don't recurse - just set flag for GUI to show
    }
}

; ===== CONSOLE LOGGING =====

Log(msg) {
    local ts := Format("{:02d}:{:02d}:{:02d}", A_Hour, A_Min, A_Sec)
    local line := "[" . ts . "] " . msg
    
    STATE.consoleLines.Push(line)
    if STATE.consoleLines.Length > CONFIG.maxLogLines
        STATE.consoleLines.RemoveAt(1)
    
    ; Log to file
    LogToFile(msg)
    
    ; Update GUI
    if STATE.gui {
        local out := ""
        for l in STATE.consoleLines
            out .= l . "`n"
        try {
            STATE.gui["_Console"].Value := out
            STATE.gui["_Console"].EditSelStart := StrLen(out) - 1
        }
        
        ; Show log write status
        UpdateLogStatus()
    }
    
    UpdateStatus()
}

UpdateLogStatus() {
    if !STATE.gui
        return
    
    local status := STATE.lastLogWriteOk ? "" : " [LOG ERR]"
    STATE.gui["_LogStatus"].Value := status
    STATE.gui["_LogStatus"].Opt(STATE.lastLogWriteOk ? "c004400" : "cff0000")
}

UpdateStatus() {
    if !STATE.gui
        return
    
    local status := "IDLE"
    local color := "c808080"
    
    if STATE.injected {
        status := "INJECTED"
        color := "c00ff00"
    } else if STATE.isRegistered {
        status := "READY"
        color := "cffff00"
    }
    
    STATE.gui["_Status"].Value := "* " . status
    STATE.gui["_Status"].Opt(color)
}

UpdateInfo() {
    if !STATE.gui
        return
    
    local username := GetUsername()
    local clients := GetClients()
    local pidStr := STATE.robloxPids.Length > 0 ? STATE.robloxPids[1] : "---"
    
    STATE.gui["_Info"].Value := "USER: " . (username ? username : "---") . " | PID: " . pidStr . " | CLIENTS: " . clients.Length
}

; Periodic client refresh
StartClientRefresh() {
    STATE.clientRefreshTimer := 0
    SetTimer(RefreshClients, 5000)  ; Every 5 seconds
}

StopClientRefresh() {
    SetTimer(RefreshClients, 0)
}

RefreshClients() {
    if !STATE.gui || !STATE.injected
        return
    UpdateInfo()
}

