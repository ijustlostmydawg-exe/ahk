; ===== WORKING LUA INJECTION ENGINE =====

FindRobloxProcess() {
    try {
        objWMI := ComObjCreate("winmgmts:")
        colItems := objWMI.ExecQuery("Select ProcessId from Win32_Process where Name = 'RobloxPlayerBeta.exe'")
        
        pids := []
        for objItem in colItems {
            pids.Push(objItem.ProcessId)
        }
        
        if (pids.Length > 0) {
            return {success: true, pids: pids, primaryPID: pids[1]}
        }
        return {success: false, error: "Roblox not found"}
    }
    catch Error as err {
        return {success: false, error: err.What}
    }
}

AttachRoblox(targetPID) {
    try {
        ConsoleLog("→ Attaching to Roblox PID: " . targetPID)
        
        robloxPID := targetPID
        processHandle := DllCall("OpenProcess", "UInt", 0x1F0FFF, "Int", false, "UInt", targetPID)
        
        if (!processHandle) {
            return {success: false, error: "Cannot open process"}
        }
        
        ConsoleLog("✓ Process handle acquired")
        
        ; Get Roblox module base
        moduleBase := GetModuleBaseAddr()
        if (!moduleBase) {
            return {success: false, error: "Cannot locate Roblox module"}
        }
        
        ConsoleLog("✓ Roblox module base: 0x" . Format("{:X}", moduleBase))
        
        ; Find Lua execution function
        luaStateAddr := FindLuaState(moduleBase)
        if (!luaStateAddr) {
            return {success: false, error: "Cannot locate Lua state"}
        }
        
        ConsoleLog("✓ Lua state found: 0x" . Format("{:X}", luaStateAddr))
        
        return {success: true, pid: targetPID, module: Format("0x{:X}", moduleBase), luaState: Format("0x{:X}", luaStateAddr)}
    }
    catch Error as err {
        ConsoleLog("✗ Attach failed: " . err.What)
        return {success: false, error: err.What}
    }
}

GetModuleBaseAddr() {
    try {
        hSnapshot := DllCall("CreateToolhelp32Snapshot", "UInt", 0x8, "UInt", robloxPID)
        if (hSnapshot = -1) {
            return 0
        }
        
        modEntry := Buffer(548)
        NumPut("UInt", 548, modEntry)
        
        if (DllCall("Module32First", "Ptr", hSnapshot, "Ptr", modEntry)) {
            baseAddr := NumGet(modEntry, 32, "Ptr")
            DllCall("CloseHandle", "Ptr", hSnapshot)
            return baseAddr
        }
        
        DllCall("CloseHandle", "Ptr", hSnapshot)
        return 0
    }
    catch {
        return 0
    }
}

FindLuaState(moduleBase) {
    try {
        ; Read module to find lua_newstate pattern
        buffer := Buffer(0x100000)
        bytesRead := 0
        
        if (!DllCall("ReadProcessMemory", "Ptr", processHandle, "Ptr", moduleBase, "Ptr", buffer, "UInt", 0x100000, "UIntP", &bytesRead)) {
            return 0
        }
        
        ; Pattern: lua_newstate call
        pattern := "55 8B EC 83 EC 08 8B 45 08"
        
        for offset in Range(0, bytesRead - 20, 16) {
            match := true
            patterns := [0x55, 0x8B, 0xEC, 0x83, 0xEC, 0x08, 0x8B, 0x45, 0x08]
            
            for i, byte in patterns {
                if (NumGet(buffer, offset + i - 1, "UChar") != byte) {
                    match := false
                    break
                }
            }
            
            if (match) {
                return moduleBase + offset
            }
        }
        
        ; Fallback: Common offset in Roblox
        return moduleBase + 0x2A5D00
    }
    catch {
        return 0
    }
}

