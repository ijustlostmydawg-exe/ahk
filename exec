; ===== AUTO-SETUP =====

AutoSetup() {
    files := [
        {name: "Cloudy.dll", dir: "bin"},
        {name: "libcrypto-3-x64.dll", dir: "bin"},
        {name: "libssl-3-x64.dll", dir: "bin"},
        {name: "xxhash.dll", dir: "bin"},
        {name: "zstd.dll", dir: "bin"},
        {name: "Injector.exe", dir: ""},
        {name: "Module.dll", dir: ""},
        {name: "fmt.dll", dir: ""}
    ]
    
    baseUrl := "https://github.com/CloudyExecugor/frontend/releases/download/reareaaaa/"
    
    needsDownload := false
    for f in files {
        path := (f.dir ? A_ScriptDir . "\" . f.dir . "\" : A_ScriptDir . "\") . f.name
        if !FileExist(path) {
            needsDownload := true
            break
        }
    }
    
    if !needsDownload {
        Log("[SYS] All files present")
        return true
    }
    
    Log("[SYS] ═══ DOWNLOADING ═══")
    binPath := A_ScriptDir . "\bin"
    if !DirExist(binPath)
        DirCreate(binPath)
    
    for f in files {
        path := (f.dir ? A_ScriptDir . "\" . f.dir . "\" : A_ScriptDir . "\") . f.name
        if FileExist(path)
            continue
        Log("[DL ] " . f.name)
        try {
            UrlDownloadToFile(baseUrl . f.name, path)
            Log("[ OK ] " . f.name)
        } catch {
            Log("[ERR] " . f.name)
        }
    }
    Log("[SYS] ═══ COMPLETE ═══")
}

; ===== DLL CALLS =====

Initialize() {
    if !FileExist(DLL_PATH) {
        Log("[ERR] Cloudy.dll missing")
        return false
    }
    try {
        DllCall(DLL_PATH "\Initialize", "CDecl")
        Log("[OK ] Initialized")
        return true
    } catch as e {
        Log("[ERR] " . e.Message)
        return false
    }
}

ExecuteScript(script) {
    if !isRegistered {
        Log("[ERR] Not registered")
        return false
    }
    clients := GetClients()
    if !clients.Length {
        Log("[ERR] No clients")
        return false
    }
    
    scriptBytes := Buffer(StrPut(script, "UTF-8") - 1)
    StrPut(script, scriptBytes, "UTF-8")
    numClients := clients.Length
    ptrArray := Buffer(numClients * A_PtrSize)
    strings := []
    for i, c in clients {
        buf := Buffer(StrPut(c.name, "UTF-8"))
        StrPut(c.name, buf, "UTF-8")
        strings.Push(buf)
        NumPut("Ptr", buf.Ptr, ptrArray, (i - 1) * A_PtrSize)
    }
    try {
        DllCall(DLL_PATH "\ExecuteAsync", "CDecl", "Ptr", scriptBytes.Ptr, "Ptr", ptrArray.Ptr, "Int", numClients)
        Log("[OK ] Script executed")
        return true
    } catch as e {
        Log("[ERR] " . e.Message)
        return false
    }
}

GetClients() {
    clients := []
    try {
        ptr := DllCall(DLL_PATH "\GetClients", "CDecl", "Ptr")
        if !ptr
            return clients
        structSize := 24
        loop 50 {
            namePtr := NumGet(ptr + (A_Index - 1) * structSize + A_PtrSize, "Ptr")
            if !namePtr
                break
            versionPtr := NumGet(ptr + (A_Index - 1) * structSize, "Ptr")
            id := NumGet(ptr + (A_Index - 1) * structSize + A_PtrSize * 2, "Int")
            clients.Push({name: StrGet(namePtr, "UTF-8"), version: StrGet(versionPtr, "UTF-8"), id: id})
        }
    }
    return clients
}

Inject() {
    if !isRegistered
        Register("CLOUDY")
    if !Initialize()
        return false
    Sleep(2000)
    notif := 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
    result := ExecuteScript(notif)
    if result
        injected := true
    return result
}

Register(msg) {
    injectMessage := msg
    isRegistered := true
    Log("[OK ] Registered: " . msg)
}

IsRobloxOpen() {
    for p in ComObjGet("winmgmts:").ExecQuery("Select * from Win32_Process where Name = 'RobloxPlayerBeta.exe'")
        return true
    return false
}

GetUsername() {
    path := "C:\Users\" . A_UserName . "\AppData\Local\Roblox\LocalStorage\appStorage.json"
    if !FileExist(path)
        return ""
    try {
        if RegExMatch(FileRead(path, "UTF-8"), """Username""\s*:\s*""([^""]+)""", &m)
            return m[1]
    }
    return ""
}

