; ===== AUTO-SETUP =====

AutoSetup() {
    local files := [
        {name: "Cloudy.dll", dir: "bin"},
        {name: "libcrypto-3-x64.dll", dir: "bin"},
        {name: "libssl-3-x64.dll", dir: "bin"},
        {name: "xxhash.dll", dir: "bin"},
        {name: "zstd.dll", dir: "bin"},
        {name: "Injector.exe", dir: ""},
        {name: "Module.dll", dir: ""},
        {name: "fmt.dll", dir: ""}
    ]
    
    local baseUrl := "https://github.com/CloudyExecugor/frontend/releases/download/reareaaaa/"
    
    local needsDownload := false
    for f in files {
        local path := (f.dir ? A_ScriptDir . "\\" . f.dir . "\\" : A_ScriptDir . "\\") . f.name
        if !FileExist(path) {
            needsDownload := true
            break
        }
    }
    
    if !needsDownload {
        Log("[SYS] All files present")
        return true
    }
    
    Log("[SYS] ═══ DOWNLOADING ═══")
    local binPath := A_ScriptDir . "\bin"
    if !DirExist(binPath)
        DirCreate(binPath)
    
    for f in files {
        local path := (f.dir ? A_ScriptDir . "\\" . f.dir . "\\" : A_ScriptDir . "\\") . f.name
        if FileExist(path)
            continue
        Log("[DL ] " . f.name)
        try {
            ; Download to temp file first
            local tmp := path . ".tmp"
            UrlDownloadToFile(baseUrl . f.name, tmp)
            if FileExist(tmp) {
                local size := FileGetSize(tmp)
                if (size > 0) {
                    ; ensure parent dir exists
                    parent := RegExReplace(path, "\\[^\\]+$", "")
                    if parent && !DirExist(parent)
                        DirCreate(parent)
                    FileMove(tmp, path, 1)
                    Log("[ OK ] " . f.name)
                } else {
                    FileDelete(tmp)
                    Log("[ERR] " . f.name . " - empty file")
                }
            } else {
                Log("[ERR] " . f.name . " - download failed")
            }
        } catch as e {
            if FileExist(tmp)
                FileDelete(tmp)
            Log("[ERR] " . f.name . " - " . e.Message)
        }
    }
    Log("[SYS] ═══ COMPLETE ═══")
}

; ===== DLL CALLS =====

Initialize() {
    global DLL_PATH
    if !FileExist(DLL_PATH) {
        Log("[ERR] Cloudy.dll missing")
        return false
    }
    try {
        local result := DllCall(DLL_PATH "\Initialize", "Int", "Cdecl")
        Log("[OK ] Initialized (return: " . result . ")")
        return true
    } catch as e {
        Log("[ERR] " . e.Message)
        return false
    }
}

ExecuteScript(script) {
    global isRegistered, injected, DLL_PATH
    if !isRegistered {
        Log("[ERR] Not registered")
        return false
    }
    local clients := GetClients()
    if !clients.Length {
        Log("[ERR] No clients")
        return false
    }
    
    ; Safe buffer allocation (include NUL)
    local scriptSize := StrPut(script, "UTF-8")
    local scriptBytes := Buffer(scriptSize)
    StrPut(script, scriptBytes, "UTF-8")

    local numClients := clients.Length
    local ptrArray := Buffer(numClients * A_PtrSize)
    local strings := [] ; keep buffers alive
    for i, c in clients {
        local nameSize := StrPut(c.name, "UTF-8")
        local buf := Buffer(nameSize)
        StrPut(c.name, buf, "UTF-8")
        strings.Push(buf)
        NumPut(buf.Ptr, ptrArray, (i - 1) * A_PtrSize, "Ptr")
    }
    try {
        local result := DllCall(DLL_PATH "\ExecuteAsync", "Int", "Ptr", scriptBytes.Ptr, "Ptr", ptrArray.Ptr, "Int", numClients, "Cdecl")
        Log("[OK ] Script executed (return: " . result . ")")
        injected := true
        return true
    } catch as e {
        Log("[ERR] " . e.Message)
        return false
    }
}

GetClients() {
    global DLL_PATH
    local clients := []
    if !FileExist(DLL_PATH)
        return clients
    try {
        local ptr := DllCall(DLL_PATH "\GetClients", "Ptr", "Cdecl")
        if !ptr
            return clients
        ; calculate struct size (versionPtr, namePtr, int id, padding)
        local structSize := 24
        local maxClients := 50
        loop maxClients {
            local offset := (A_Index - 1) * structSize
            local namePtr := NumGet(ptr, offset + A_PtrSize, "Ptr")
            if !namePtr
                break
            local versionPtr := NumGet(ptr, offset, "Ptr")
            local id := NumGet(ptr, offset + (A_PtrSize * 2), "Int")
            local name := StrGet(namePtr, "UTF-8")
            local version := (versionPtr ? StrGet(versionPtr, "UTF-8") : "")
            clients.Push({name: name, version: version, id: id})
        }
    } catch as e {
        Log("[WRN] GetClients error: " . e.Message)
    }
    return clients
}

Inject() {
    global isRegistered
    if !isRegistered
        Register("CLOUDY")
    if !Initialize()
        return false
    Sleep(2000)
    local notif := 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
    local result := ExecuteScript(notif)
    if result
        injected := true
    return result
}

Register(msg) {
    global injectMessage, isRegistered
    injectMessage := msg
    isRegistered := true
    Log("[OK ] Registered: " . msg)
}

IsRobloxOpen() {
    try {
        for p in ComObjGet("winmgmts:").ExecQuery("Select * from Win32_Process where Name = 'RobloxPlayerBeta.exe'")
            return true
    } catch
    return false
}

GetUsername() {
    ; Use local AppData to be more robust
    local path := A_LocalAppData . "\Roblox\LocalStorage\appStorage.json"
    if !FileExist(path)
        return ""
    try {
        local content := FileRead(path, "UTF-8")
        if RegExMatch(content, """Username""" . "\s*:\s*""""([^"]+)"""", &m)
            return m[1]
    } catch
    return ""
}

