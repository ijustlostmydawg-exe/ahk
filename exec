#Requires AutoHotkey v2.0
#SingleInstance Force

global DLL_PATH := A_ScriptDir . "\bin\Cloudy.dll"
global isRegistered := false
global injectMessage := ""
global consoleLines := []
global gui := 0
global injected := false
global animPhase := 0

; ===== AUTO-SETUP =====

AutoSetup() {
    local files := [
        {name: "Cloudy.dll", dir: "bin"},
        {name: "libcrypto-3-x64.dll", dir: "bin"},
        {name: "libssl-3-x64.dll", dir: "bin"},
        {name: "xxhash.dll", dir: "bin"},
        {name: "zstd.dll", dir: "bin"},
        {name: "Injector.exe", dir: ""},
        {name: "Module.dll", dir: ""},
        {name: "fmt.dll", dir: ""}
    ]
    
    local baseUrl := "https://github.com/CloudyExecugor/frontend/releases/download/reareaaaa/"
    local needsDownload := false
    
    for f in files {
        local path := (f.dir ? A_ScriptDir . "\" . f.dir . "\" : A_ScriptDir . "\") . f.name
        if !FileExist(path) {
            needsDownload := true
            break
        }
    }
    
    if !needsDownload {
        Log("[SYS] All files present")
        return true
    }
    
    Log("[SYS] ═══ DOWNLOADING ═══")
    local binPath := A_ScriptDir . "\bin"
    if !DirExist(binPath)
        DirCreate(binPath)
    
    for f in files {
        local path := (f.dir ? A_ScriptDir . "\" . f.dir . "\" : A_ScriptDir . "\") . f.name
        if FileExist(path)
            continue
        
        Log("[DL ] " . f.name)
        local tmp := path . ".tmp"
        
        try {
            UrlDownloadToFile(baseUrl . f.name, tmp)
            
            if FileExist(tmp) {
                local size := FileGetSize(tmp)
                if (size > 0) {
                    FileMove(tmp, path, 1)
                    Log("[ OK ] " . f.name)
                } else {
                    FileDelete(tmp)
                    Log("[ERR] " . f.name . " - empty file")
                }
            } else {
                Log("[ERR] " . f.name . " - download failed")
            }
        } catch as e {
            if FileExist(tmp)
                FileDelete(tmp)
            Log("[ERR] " . f.name . " - " . e.Message)
        }
    }
    
    Log("[SYS] ═══ COMPLETE ═══")
}

; ===== DLL CALLS =====

Initialize() {
    if !FileExist(DLL_PATH) {
        Log("[ERR] Cloudy.dll missing")
        return false
    }
    try {
        local result := DllCall(DLL_PATH "\Initialize", "Int", "CDecl")
        Log("[ OK ] Initialized")
        return true
    } catch as e {
        Log("[ERR] " . e.Message)
        return false
    }
}

ExecuteScript(script) {
    if !isRegistered {
        Log("[ERR] Not registered")
        return false
    }
    
    local clients := GetClients()
    if !clients.Length {
        Log("[ERR] No clients")
        return false
    }
    
    local scriptSize := StrPut(script, "UTF-8")
    local scriptBytes := Buffer(scriptSize)
    StrPut(script, scriptBytes, "UTF-8")

    local numClients := clients.Length
    local ptrArray := Buffer(numClients * A_PtrSize)
    local strings := []
    
    for i, c in clients {
        local nameSize := StrPut(c.name, "UTF-8")
        local buf := Buffer(nameSize)
        StrPut(c.name, buf, "UTF-8")
        strings.Push(buf)
        NumPut(buf.Ptr, ptrArray, (i - 1) * A_PtrSize, "Ptr")
    }
    
    try {
        DllCall(DLL_PATH "\ExecuteAsync", "Int", "Ptr", scriptBytes.Ptr, "Ptr", ptrArray.Ptr, "Int", numClients, "CDecl")
        Log("[ OK ] Script executed")
        return true
    } catch as e {
        Log("[ERR] " . e.Message)
        return false
    }
}

GetClients() {
    local clients := []
    if !FileExist(DLL_PATH)
        return clients
    try {
        local ptr := DllCall(DLL_PATH "\GetClients", "Ptr", "CDecl")
        if !ptr
            return clients
        
        local structSize := (A_PtrSize * 2) + 4
        if (Mod(structSize, A_PtrSize) != 0)
            structSize += (A_PtrSize - Mod(structSize, A_PtrSize))
        
        loop 50 {
            local offset := (A_Index - 1) * structSize
            local namePtr := NumGet(ptr, offset + A_PtrSize, "Ptr")
            if !namePtr
                break
            local versionPtr := NumGet(ptr, offset, "Ptr")
            local id := NumGet(ptr, offset + (A_PtrSize * 2), "Int")
            local name := StrGet(namePtr, "UTF-8")
            local version := (versionPtr ? StrGet(versionPtr, "UTF-8") : "")
            clients.Push({name: name, version: version, id: id})
        }
    } catch as e {
        Log("[WRN] GetClients: " . e.Message)
    }
    return clients
}

Inject() {
    if !isRegistered
        Register("CLOUDY")
    if !Initialize()
        return false
    Sleep(2000)
    local notif := 'game:GetService("StarterGui"):SetCore("SendNotification", {Title = "CLOUDY", Text = "INJECTED"})'
    local result := ExecuteScript(notif)
    if result
        injected := true
    return result
}

Register(msg) {
    injectMessage := msg
    isRegistered := true
    Log("[ OK ] Registered: " . msg)
}

IsRobloxOpen() {
    try {
        for p in ComObjGet("winmgmts:").ExecQuery("Select * from Win32_Process where Name = 'RobloxPlayerBeta.exe'")
            return true
    }
    return false
}

GetUsername() {
    local path := A_LocalAppData . "\Roblox\LocalStorage\appStorage.json"
    if !FileExist(path)
        return ""
    try {
        local content := FileRead(path, "UTF-8")
        if RegExMatch(content, """Username""\s*:\s*""([^""]+)""", &m)
            return m[1]
    }
    return ""
}

; ===== LOGGING =====

Log(msg) {
    local ts := Format("{:02d}:{:02d}:{:02d}", A_Hour, A_Min, A_Sec)
    local line := "[" . ts . "] " . msg
    consoleLines.Push(line)
    if consoleLines.Length > 200
        consoleLines.RemoveAt(1)
    if gui {
        local out := ""
        for l in consoleLines
            out .= l . "`n"
        try {
            gui["_Console"].Value := out
            local len := StrLen(out)
            gui["_Console"].EditSelStart := (len > 0 ? len - 1 : 0)
        }
    }
    UpdateStatus()
}

UpdateStatus() {
    if !gui
        return
    local status := "IDLE"
    local color := "c808080"
    if injected {
        status := "INJECTED"
        color := "c00ff00"
    } else if isRegistered {
        status := "READY"
        color := "cffff00"
    }
    try {
        gui["_Status"].Value := "● " . status
        gui["_Status"].Opt(color)
    }
}

UpdateInfo() {
    if !gui
        return
    local username := GetUsername()
    local clients := GetClients()
    gui["_Info"].Value := "USER: " . (username ? username : "---") . " | CLIENTS: " . clients.Length
}

; ===== CRT EFFECT =====

StartCRTEffect() {
    SetTimer(CRTFlash, 100)
}

CRTFlash() {
    animPhase++
    if !gui
        return
    try {
        if (Mod(animPhase, 10) = 0)
            gui.Opt("+Border " . (Mod(animPhase, 20) = 0 ? "0x003300" : "0x002200"))
    }
}

