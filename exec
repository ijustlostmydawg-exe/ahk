DetachRoblox() {
    try {
        if (processHandle) {
            DllCall("CloseHandle", "Ptr", processHandle)
            processHandle := 0
            robloxPID := 0
            luaStateAddr := 0
            ConsoleLog("✓ Detached from Roblox")
            return {success: true}
        }
        return {success: false, error: "Not attached"}
    }
    catch Error as err {
        ConsoleLog("✗ Detach error: " . err.What)
        return {success: false, error: err.What}
    }
}

Range(start, end, step := 1) {
    results := []
    if (start <= end) {
        loop ((end - start) // step + 1) {
            results.Push(start + (A_Index - 1) * step)
        }
    }
    return results
}

