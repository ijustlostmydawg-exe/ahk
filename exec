KillRoblox() {
    for p in ComObjGet("winmgmts:").ExecQuery("Select * from Win32_Process where Name = 'RobloxPlayerBeta.exe'") {
        try
            p.Terminate()
    }
    Log("[SYS] Roblox terminated")
    injected := false
}

ExitApp() {
    if gui
        gui.Destroy()
    ExitApp()
}

UpdateInfo() {
