ConsoleLog(message) {
    timestamp := Format("{:02d}:{:02d}:{:02d}", A_Hour, A_Min, A_Sec)
    logEntry := "[" . timestamp . "] " . message
    
    consoleOutput.Push(logEntry)
    if (consoleOutput.Length > maxConsoleLines) {
        consoleOutput.RemoveAt(1)
    }
    
    try {
        global MyGui
        if (MyGui) {
            fullText := ""
            for line in consoleOutput {
                fullText .= line . "`n"
            }
            MyGui["_ConsoleOutput"].Value := fullText
        }
    }
}

