; ===== LOGGING =====

Log(msg) {
    global consoleLines, gui
    local ts := Format("{:02d}:{:02d}:{:02d}", A_Hour, A_Min, A_Sec)
    local line := "[" . ts . "] " . msg
    consoleLines.Push(line)
    if consoleLines.Length > 200
        consoleLines.RemoveAt(1)
    if gui {
        local out := ""
        for l in consoleLines
            out .= l . "`n"
        try {
            gui["_Console"].Value := out
            local len := StrLen(out)
            gui["_Console"].EditSelStart := (len > 0 ? len - 1 : 0)
        } catch
        {
            ; ignore gui write errors
        }
    }
    UpdateStatus()
}

UpdateStatus() {
    global gui, injected, isRegistered
    if !gui
        return
    local status := "IDLE"
    local color := "c808080"
    if injected {
        status := "INJECTED"
        color := "c00ff00"
    } else if isRegistered {
        status := "READY"
        color := "cffff00"
    }
    try {
        gui["_Status"].Value := "● " . status
        gui["_Status"].Opt(color)
    } catch
    {
        ; ignore
    }
}

